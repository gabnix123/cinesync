# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.lerna/

# Environment
.env
.env.*
!**/.env.example  # allow example file

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/cli.html#cli_diagnostic_report_on_fatal_error)
report.[0-9]*.[0-9]*.[0-9]*.[*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov*

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#task-storage)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components/

# node-waf configuration
.lock-wscript

# Compiler builds
*.o
*.common
*.dependency
*.tree

# Node.js recompiled binding
build/
Release/

# npm aliases
# https://www.npmjs.com/package/alias
.npm aliases

# ES2015+ module cache
es2015-module-cache/

# TypeScript
*.tsbuildinfo

# Vercel
.vercel/

# Build output
dist/
Downloads/